# Build context must be the repo root (the worker reads companies.toml):
#   docker build -f web/Dockerfile.worker .
FROM node:22-slim
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app/web
COPY web/package*.json ./
COPY web/prisma ./prisma
RUN npm ci
COPY web/ ./
COPY companies.toml /app/companies.toml
ENV COMPANIES_TOML=/app/companies.toml
CMD ["sh", "-c", "npx prisma db push --skip-generate && npm run worker"]
